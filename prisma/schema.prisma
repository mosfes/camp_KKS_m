// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum role {
  TEACHER
  CAMP_LEADER
  ADMIN
}

model teachers {
  teachers_id       Int       @id @default(autoincrement())
  prefix_name       String?   @db.VarChar(255)
  role              role      @default(TEACHER)
  firstname         String    @db.VarChar(255)
  lastname          String    @db.VarChar(255)
  tel               String    @db.VarChar(10)
  email             String    @db.VarChar(255)
  profile_image_url String?   @db.VarChar(500)
  deletedAt         DateTime?

  classrooms                        classrooms[]
  classroom_teacher                 classroom_teacher[]
  camp                              camp[]
  teacher_enrollment                teacher_enrollment[]
  survey_template                   survey_template[]
  camp_location_update              camp_location_update[]
  project_document_template         project_document_template[]
  project_summary_document_template project_summary_document_template[]
  camp_bus_events                   camp_bus_event[]
  camp_bus_teacher                  camp_bus_teacher[]
  bus_layout_template               bus_layout_template[]
  promotion_runs                    promotion_run[]

  @@index([deletedAt])
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

model students {
  students_id       Int           @id
  prefix_name       String?       @db.VarChar(255)
  firstname         String        @db.VarChar(255)
  lastname          String        @db.VarChar(255)
  nickname          String?       @db.VarChar(100)
  profile_image_url String?       @db.VarChar(500)
  birthday          DateTime?
  food_allergy      String?       @db.VarChar(255)
  chronic_disease   String?       @db.VarChar(255)
  remark            String?       @db.VarChar(255)
  tel               String?       @db.VarChar(10)
  email             String        @db.VarChar(255)
  status            StudentStatus @default(ACTIVE)
  deletedAt         DateTime?

  parents                   parents[]
  classroom_students        classroom_students[]
  student_enrollment        student_enrollment[]
  attendance_record_student attendance_record_student[]
  student_location_update   student_location_update[]
  promotion_items           promotion_item[]

  @@index([deletedAt])
  @@index([status])
}

model parents {
  parents_id        Int       @id @default(autoincrement())
  firstname         String    @db.VarChar(255)
  lastname          String    @db.VarChar(255)
  tel               String    @db.VarChar(10)
  email             String?   @db.VarChar(255)
  email_verified_at DateTime?
  password          String    @db.VarChar(255)
  session_version   Int       @default(0)

  username_student_id Int
  student             students             @relation(fields: [username_student_id], references: [students_id])
  auth_tokens         parent_auth_tokens[]

  @@index([email])
}

enum ParentAuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model parent_auth_tokens {
  token_id   Int                 @id @default(autoincrement())
  parents_id Int
  token_hash String              @unique @db.Char(64)
  type       ParentAuthTokenType
  email      String?             @db.VarChar(255)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime            @default(now())

  parent parents @relation(fields: [parents_id], references: [parents_id], onDelete: Cascade)

  @@index([parents_id, type, used_at, expires_at])
}

model academic_years {
  // years_id   Int          @id @default(autoincrement())
  status              String               @db.VarChar(255) // ลบ จัดเก็บ แอคทีฟ
  year                Int                  @id
  classrooms          classrooms[]
  classroom_students  classroom_students[]
  promotion_runs_from promotion_run[]      @relation("PromotionFromYear")
  promotion_runs_to   promotion_run[]      @relation("PromotionToYear")
}

model classrooms {
  classroom_id            Int            @id @default(autoincrement())
  deletedAt               DateTime?
  // type_classroom          String         @db.VarChar(255)
  grade                   GradeLevel
  academic_years_years_id Int
  academic_years          academic_years @relation(fields: [academic_years_years_id], references: [year])

  teachers_teachers_id Int
  teacher              teachers @relation(fields: [teachers_teachers_id], references: [teachers_id])

  type_classroom  Int
  classroom_types classroom_types @relation(fields: [type_classroom], references: [classroom_type_id])

  classroom_teacher  classroom_teacher[]
  classroom_students classroom_students[]
  camp_classroom     camp_classroom[]
  camp_bus           camp_bus[]
  enrollment_history student_enrollment[] @relation("EnrollmentClassroom")
  promotion_sources  promotion_item[]     @relation("PromotionSourceClassroom")
  promotion_targets  promotion_item[]     @relation("PromotionTargetClassroom")

  @@index([deletedAt])
}

model classroom_types {
  classroom_type_id Int    @id @default(autoincrement())
  name              String @unique @db.VarChar(255)
  valid_grades      String @db.VarChar(255)

  classrooms classrooms[]
}

enum GradeLevel {
  Level_1 @map("1")
  Level_2 @map("2")
  Level_3 @map("3")
  Level_4 @map("4")
  Level_5 @map("5")
  Level_6 @map("6")
}

model classroom_teacher {
  classroom_teacher_id   Int @id @default(autoincrement())
  classroom_classroom_id Int
  teacher_teachers_id    Int

  classroom classrooms @relation(fields: [classroom_classroom_id], references: [classroom_id])
  teacher   teachers   @relation(fields: [teacher_teachers_id], references: [teachers_id])

  @@unique([classroom_classroom_id, teacher_teachers_id], map: "classroom_teacher_room_teacher_key")
}

model classroom_students {
  classroom_students_id  Int @id @default(autoincrement())
  classroom_classroom_id Int
  student_students_id    Int
  academic_year          Int

  classroom          classrooms     @relation(fields: [classroom_classroom_id], references: [classroom_id])
  student            students       @relation(fields: [student_students_id], references: [students_id])
  academic_year_data academic_years @relation(fields: [academic_year], references: [year])

  @@unique([classroom_classroom_id, student_students_id], map: "classroom_students_room_student_key")
  @@unique([student_students_id, academic_year], map: "classroom_students_student_year_key")
  @@index([academic_year])
}

enum PromotionOutcome {
  PROMOTED
  REPEAT
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

enum PromotionRunStatus {
  COMPLETED
}

model promotion_run {
  promotion_run_id Int                @id @default(autoincrement())
  from_year        Int
  to_year          Int
  status           PromotionRunStatus @default(COMPLETED)
  executed_by_id   Int
  executed_at      DateTime           @default(now())

  from_academic_year academic_years   @relation("PromotionFromYear", fields: [from_year], references: [year])
  to_academic_year   academic_years   @relation("PromotionToYear", fields: [to_year], references: [year])
  executed_by        teachers         @relation(fields: [executed_by_id], references: [teachers_id])
  items              promotion_item[]

  @@unique([from_year, to_year])
  @@index([executed_by_id])
}

model promotion_item {
  promotion_item_id   Int              @id @default(autoincrement())
  promotion_run_id    Int
  student_id          Int
  source_classroom_id Int
  target_classroom_id Int?
  outcome             PromotionOutcome
  note                String?          @db.VarChar(500)
  created_at          DateTime         @default(now())

  run              promotion_run @relation(fields: [promotion_run_id], references: [promotion_run_id], onDelete: Cascade)
  student          students      @relation(fields: [student_id], references: [students_id])
  source_classroom classrooms    @relation("PromotionSourceClassroom", fields: [source_classroom_id], references: [classroom_id])
  target_classroom classrooms?   @relation("PromotionTargetClassroom", fields: [target_classroom_id], references: [classroom_id])

  @@unique([promotion_run_id, student_id])
  @@index([student_id])
  @@index([source_classroom_id])
  @@index([target_classroom_id])
}

model camp {
  camp_id                   Int         @id @default(autoincrement())
  deletedAt                 DateTime?
  location                  String      @db.VarChar(255)
  name                      String      @db.VarChar(255)
  start_date                DateTime
  end_date                  DateTime
  start_shirt_date          DateTime
  end_shirt_date            DateTime
  start_regis_date          DateTime
  end_regis_date            DateTime
  description               String      @db.Text
  status                    camp_status @default(OPEN)
  has_shirt                 Boolean     @default(false)
  img_camp_url              String      @db.VarChar(500)
  img_shirt_url             String      @db.VarChar(500)
  img_certificate_url       String?     @db.VarChar(500)
  img_certificate_public_id String?     @db.VarChar(255)
  img_certificate_bytes     Int?
  img_certificate_width     Int?
  img_certificate_height    Int?
  img_certificate_format    String?     @db.VarChar(20)
  cert_name_x               Float?
  cert_name_y               Float?
  cert_font_size            Float?
  cert_font_color           String?     @db.VarChar(50)

  // เลขที่เกียรติบัตรแบบรัน
  cert_show_number    Boolean @default(false)
  cert_number_start   Int?
  cert_number_end     Int?
  cert_number_x       Float?
  cert_number_y       Float?
  cert_number_size    Float?
  cert_number_color   String? @db.VarChar(50)
  cert_number_prefix  String? @db.VarChar(20)
  cert_number_is_thai Boolean @default(false)
  cert_year           String? @db.VarChar(20)

  // คิวอาร์โค้ดสำหรับตรวจสอบเกียรติบัตร
  cert_show_qr Boolean @default(false)
  cert_qr_x    Float?
  cert_qr_y    Float?
  cert_qr_size Float?

  // เงื่อนไขการรับเกียรติบัตร
  cert_mission_completion_percent Int     @default(100)
  cert_require_survey             Boolean @default(false)

  // จุดหมายและการตั้งค่าการแชร์ตำแหน่งของนักเรียนในค่าย
  destination_name         String? @db.VarChar(255)
  destination_address      String? @db.VarChar(500)
  destination_latitude     Float?
  destination_longitude    Float?
  location_sharing_enabled Boolean @default(false)
  has_transport            Boolean @default(false)
  location_update_interval Int     @default(10)

  // plan_type_plane_id Int
  // plan_type          plan_type @relation(fields: [plan_type_plane_id], references: [plane_id])

  created_by_teacher_id Int
  created_by            teachers @relation(fields: [created_by_teacher_id], references: [teachers_id])

  camp_template            camp_template[]
  camp_classroom           camp_classroom[]
  camp_bus                 camp_bus[]
  teacher_enrollment       teacher_enrollment[]
  student_enrollment       student_enrollment[]
  attendance_session       attendance_session[]
  attendance_teachers      attendance_teachers[]
  station                  station[]
  camp_daily_schedule      camp_daily_schedule[]
  survey                   survey[]
  location_updates         camp_location_update[]
  student_location_updates student_location_update[]
  project_document         camp_project_document?
  project_summary_document camp_project_summary_document?
  camp_bus_teacher         camp_bus_teacher[]
  email_reminders          camp_email_reminder[]

  @@index([deletedAt])
  @@index([created_by_teacher_id])
}

model document_personnel {
  document_personnel_id Int      @id @default(autoincrement())
  prefix_name           String?  @db.VarChar(50)
  firstname             String   @db.VarChar(255)
  lastname              String   @db.VarChar(255)
  position              String   @db.VarChar(500)
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([is_active])
  @@index([firstname, lastname])
}

model camp_project_document {
  camp_project_document_id Int       @id @default(autoincrement())
  camp_camp_id             Int       @unique
  camp                     camp      @relation(fields: [camp_camp_id], references: [camp_id], onDelete: Cascade)
  fiscal_year              Int
  project_name             String    @db.VarChar(500)
  project_code             String?   @db.VarChar(100)
  activity_name            String?   @db.VarChar(500)
  activity_order           String?   @db.VarChar(100)
  project_type             String    @default("CONTINUING") @db.VarChar(30)
  standards                String?   @db.Text
  strategy                 String?   @db.Text
  responsible_people       String?   @db.Text
  department               String?   @db.VarChar(500)
  rationale                String?   @db.LongText
  objectives               Json
  quantitative_targets     Json
  qualitative_targets      Json
  procedures               Json
  duration_text            String?   @db.VarChar(500)
  location_text            String?   @db.VarChar(500)
  budget_total             Float     @default(0)
  budget_source            String?   @db.VarChar(100)
  budget_items             Json
  evaluations              Json
  expected_results         Json
  signatories              Json
  status                   String    @default("DRAFT") @db.VarChar(20)
  finalized_at             DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  @@index([camp_camp_id])
  @@index([status])
}

model camp_project_summary_document {
  camp_project_summary_document_id Int       @id @default(autoincrement())
  camp_camp_id                     Int       @unique
  camp                             camp      @relation(fields: [camp_camp_id], references: [camp_id], onDelete: Cascade)
  fiscal_year                      Int
  project_name                     String    @db.VarChar(500)
  project_code                     String?   @db.VarChar(100)
  activity_name                    String?   @db.VarChar(500)
  activity_order                   String?   @db.VarChar(100)
  project_nature                   String    @default("CONTINUING") @db.VarChar(30)
  project_type                     String    @default("CONTINUING") @db.VarChar(30)
  plan_alignment                   String    @default("IN_EVALUATION_PLAN") @db.VarChar(30)
  standards                        String?   @db.Text
  standard_alignments              Json
  strategy                         String?   @db.Text
  responsible_people               String?   @db.Text
  department                       String?   @db.VarChar(500)
  objectives                       Json
  execution_status                 String    @default("COMPLETED") @db.VarChar(30)
  duration_text                    String?   @db.VarChar(500)
  location_text                    String?   @db.VarChar(500)
  budget_received                  Float     @default(0)
  budget_spent                     Float     @default(0)
  budget_source                    String?   @db.VarChar(100)
  quantitative_results             Json
  qualitative_results              Json
  success_indicators               Json
  evaluation_results               Json
  evaluation_summary               String?   @db.LongText
  overall_average                  Float?
  overall_sd                       Float?
  top_strengths                    Json
  suggestions                      Json
  operation_assessment             Json
  problems                         String?   @db.LongText
  recommendations                  String?   @db.LongText
  continuation_reason              String?   @db.LongText
  signatories                      Json
  status                           String    @default("DRAFT") @db.VarChar(20)
  finalized_at                     DateTime?
  source_snapshot_at               DateTime?
  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt

  photos camp_project_summary_photo[]

  @@index([camp_camp_id])
  @@index([status])
}

model camp_project_summary_photo {
  camp_project_summary_photo_id Int                           @id @default(autoincrement())
  summary_document_id           Int
  summary_document              camp_project_summary_document @relation(fields: [summary_document_id], references: [camp_project_summary_document_id], onDelete: Cascade)
  image_url                     String                        @db.Text
  public_id                     String?                       @db.VarChar(255)
  caption                       String?                       @db.VarChar(500)
  sort_order                    Int                           @default(0)
  created_at                    DateTime                      @default(now())
  updated_at                    DateTime                      @updatedAt

  @@index([summary_document_id, sort_order])
}

model project_document_template {
  project_document_template_id Int      @id @default(autoincrement())
  name                         String   @db.VarChar(255)
  description                  String?  @db.VarChar(500)
  template_data                Json
  created_by_teacher_id        Int
  created_by                   teachers @relation(fields: [created_by_teacher_id], references: [teachers_id], onDelete: Cascade)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  @@unique([created_by_teacher_id, name])
  @@index([created_by_teacher_id, updated_at])
}

model project_summary_document_template {
  project_summary_document_template_id Int      @id @default(autoincrement())
  name                                 String   @db.VarChar(255)
  description                          String?  @db.VarChar(500)
  template_data                        Json
  created_by_teacher_id                Int
  created_by                           teachers @relation(fields: [created_by_teacher_id], references: [teachers_id], onDelete: Cascade, map: "summary_doc_template_teacher_fkey")
  created_at                           DateTime @default(now())
  updated_at                           DateTime @updatedAt

  @@unique([created_by_teacher_id, name], map: "summary_doc_template_teacher_name_key")
  @@index([created_by_teacher_id, updated_at], map: "summary_doc_template_teacher_updated_idx")
}

model document_reference_option {
  document_reference_option_id Int      @id @default(autoincrement())
  category                     String   @db.VarChar(30)
  label                        String   @db.VarChar(700)
  indicators                   Json?
  is_active                    Boolean  @default(true)
  sort_order                   Int      @default(0)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  @@unique([category, label])
  @@index([category, is_active, sort_order])
}

model camp_location_update {
  location_update_id  Int      @id @default(autoincrement())
  camp_camp_id        Int
  teacher_teachers_id Int
  latitude            Float
  longitude           Float
  accuracy            Float?
  recorded_at         DateTime @default(now()) @db.DateTime(3)

  camp    camp     @relation(fields: [camp_camp_id], references: [camp_id], onDelete: Cascade)
  teacher teachers @relation(fields: [teacher_teachers_id], references: [teachers_id])

  @@index([camp_camp_id, recorded_at])
  @@index([teacher_teachers_id])
}

model student_location_update {
  student_location_update_id Int      @id @default(autoincrement())
  camp_camp_id               Int
  student_students_id        Int
  latitude                   Float
  longitude                  Float
  accuracy                   Float?
  recorded_at                DateTime @default(now()) @db.DateTime(3)

  camp    camp     @relation(fields: [camp_camp_id], references: [camp_id], onDelete: Cascade)
  student students @relation(fields: [student_students_id], references: [students_id], onDelete: Cascade)

  @@index([camp_camp_id, student_students_id, recorded_at], map: "student_location_update_camp_student_recorded_idx")
  @@index([student_students_id, recorded_at], map: "student_location_update_student_recorded_idx")
}

enum camp_status {
  OPEN
  CLOSED
}

// model plan_type {
//   plane_id Int        @id @default(autoincrement())
//   name     plan_type_
//   // camp     camp[]
// }

// enum plan_type_ {
//   new
//   continue
// }

model camp_daily_schedule {
  daily_schedule_id Int @id @default(autoincrement())

  camp_camp_id Int
  camp         camp @relation(fields: [camp_camp_id], references: [camp_id])

  day Int

  time_slots camp_time_slot[]
}

model camp_time_slot {
  time_slot_id Int @id @default(autoincrement())

  daily_schedule_id Int
  daily_schedule    camp_daily_schedule @relation(fields: [daily_schedule_id], references: [daily_schedule_id])

  startTime String @db.VarChar(5)
  endTime   String @db.VarChar(5)
  activity  String @db.VarChar(255)
}

model camp_template {
  camp_template_id Int    @id @default(autoincrement())
  name             String @db.VarChar(255)

  camp_camp_id Int
  camp         camp @relation(fields: [camp_camp_id], references: [camp_id])
}

model camp_classroom {
  camp_classroom_id      Int @id @default(autoincrement())
  camp_camp_id           Int
  classroom_classroom_id Int

  camp      camp       @relation(fields: [camp_camp_id], references: [camp_id])
  classroom classrooms @relation(fields: [classroom_classroom_id], references: [classroom_id])
}

enum camp_bus_status {
  PARKED
  TRAVELING
}

enum camp_bus_student_status {
  OFF_BUS
  ON_BUS
}

enum camp_bus_participation_status {
  ACTIVE
  NOT_TRAVELING
}

enum camp_bus_event_type {
  BOARD
  ALIGHT
  PARK
  DEPART
  REMIND_BOARD
  REMIND_ALIGHT
}

enum bus_layout_template_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum bus_layout_element_type {
  SEAT
  DRIVER
  DOOR
  STAIRS
  TOILET
  TABLE
  EMPTY
  LABEL
}

model bus_layout_template {
  template_id           Int                        @id @default(autoincrement())
  name                  String                     @db.VarChar(120)
  description           String                     @default("") @db.VarChar(500)
  status                bus_layout_template_status @default(DRAFT)
  created_by_teacher_id Int?
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt

  created_by teachers?                   @relation(fields: [created_by_teacher_id], references: [teachers_id], onDelete: SetNull)
  floors     bus_layout_template_floor[]
  buses      camp_bus[]

  @@index([status, updated_at])
  @@index([created_by_teacher_id])
}

model bus_layout_template_floor {
  floor_id       Int    @id @default(autoincrement())
  template_id    Int
  floor_number   Int
  floor_name     String @default("") @db.VarChar(80)
  canvas_columns Int    @default(12)
  canvas_rows    Int    @default(24)

  template bus_layout_template           @relation(fields: [template_id], references: [template_id], onDelete: Cascade)
  elements bus_layout_template_element[]

  @@unique([template_id, floor_number])
}

model bus_layout_template_element {
  element_id    Int                     @id @default(autoincrement())
  floor_id      Int
  type          bus_layout_element_type
  x             Int
  y             Int
  width         Int                     @default(1)
  height        Int                     @default(1)
  rotation      Int                     @default(0)
  label         String                  @default("") @db.VarChar(50)
  is_assignable Boolean                 @default(false)
  z_index       Int                     @default(0)
  metadata      Json?

  floor bus_layout_template_floor @relation(fields: [floor_id], references: [floor_id], onDelete: Cascade)

  @@index([floor_id, type])
}

model camp_bus {
  bus_id                 Int             @id @default(autoincrement())
  camp_camp_id           Int
  classroom_classroom_id Int
  name                   String          @db.VarChar(100)
  registration_plate     String          @db.VarChar(30)
  floor_count            Int             @default(1)
  status                 camp_bus_status @default(PARKED)
  layout_locked          Boolean         @default(false) // legacy: no longer used by the application
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  layout_template_id     Int?

  camp                camp                 @relation(fields: [camp_camp_id], references: [camp_id], onDelete: Cascade)
  classroom           classrooms           @relation(fields: [classroom_classroom_id], references: [classroom_id])
  floors              camp_bus_floor[]
  assignments         camp_bus_student[]
  teacher_assignments camp_bus_teacher[]
  events              camp_bus_event[]
  layout_template     bus_layout_template? @relation(fields: [layout_template_id], references: [template_id], onDelete: SetNull)

  @@index([camp_camp_id, classroom_classroom_id])
  @@index([camp_camp_id])
  @@index([layout_template_id])
}

model camp_bus_floor {
  floor_id       Int  @id @default(autoincrement())
  bus_bus_id     Int
  floor_number   Int
  row_count      Int
  canvas_columns Int?
  canvas_rows    Int?

  bus       camp_bus                  @relation(fields: [bus_bus_id], references: [bus_id], onDelete: Cascade)
  positions camp_bus_position[]
  elements  camp_bus_layout_element[]

  @@unique([bus_bus_id, floor_number])
}

model camp_bus_position {
  position_id    Int    @id @default(autoincrement())
  floor_floor_id Int
  row_number     Int
  seat_index     Int
  label          String @db.VarChar(20)
  x              Int?
  y              Int?
  width          Int    @default(1)
  height         Int    @default(1)
  rotation       Int    @default(0)

  floor              camp_bus_floor    @relation(fields: [floor_floor_id], references: [floor_id], onDelete: Cascade)
  assignment         camp_bus_student?
  teacher_assignment camp_bus_teacher?

  @@unique([floor_floor_id, row_number, seat_index])
  @@unique([floor_floor_id, label])
}

model camp_bus_layout_element {
  element_id     Int                     @id @default(autoincrement())
  floor_floor_id Int
  type           bus_layout_element_type
  x              Int
  y              Int
  width          Int                     @default(1)
  height         Int                     @default(1)
  rotation       Int                     @default(0)
  label          String                  @default("") @db.VarChar(50)
  z_index        Int                     @default(0)
  metadata       Json?

  floor camp_bus_floor @relation(fields: [floor_floor_id], references: [floor_id], onDelete: Cascade)

  @@index([floor_floor_id, type])
}

model camp_bus_student {
  assignment_id         Int                           @id @default(autoincrement())
  bus_bus_id            Int
  student_enrollment_id Int                           @unique
  position_position_id  Int?                          @unique
  status                camp_bus_student_status       @default(OFF_BUS)
  participation_status  camp_bus_participation_status @default(ACTIVE)
  last_boarded_at       DateTime?
  updated_at            DateTime                      @updatedAt

  bus                camp_bus           @relation(fields: [bus_bus_id], references: [bus_id], onDelete: Cascade)
  student_enrollment student_enrollment @relation(fields: [student_enrollment_id], references: [student_enrollment_id], onDelete: Cascade)
  position           camp_bus_position? @relation(fields: [position_position_id], references: [position_id], onDelete: SetNull)
  events             camp_bus_event[]

  @@unique([bus_bus_id, student_enrollment_id])
  @@index([bus_bus_id, status])
  @@index([bus_bus_id, participation_status])
}

model camp_bus_teacher {
  assignment_id        Int                     @id @default(autoincrement())
  camp_camp_id         Int
  bus_bus_id           Int
  teacher_teachers_id  Int
  position_position_id Int?                    @unique
  status               camp_bus_student_status @default(OFF_BUS)
  last_boarded_at      DateTime?
  removed_at           DateTime?
  created_at           DateTime                @default(now())
  updated_at           DateTime                @updatedAt

  camp     camp               @relation(fields: [camp_camp_id], references: [camp_id], onDelete: Cascade)
  bus      camp_bus           @relation(fields: [bus_bus_id], references: [bus_id], onDelete: Cascade)
  teacher  teachers           @relation(fields: [teacher_teachers_id], references: [teachers_id], onDelete: Cascade)
  position camp_bus_position? @relation(fields: [position_position_id], references: [position_id], onDelete: SetNull)
  events   camp_bus_event[]

  @@unique([camp_camp_id, teacher_teachers_id])
  @@unique([bus_bus_id, teacher_teachers_id])
  @@index([bus_bus_id, status])
  @@index([bus_bus_id, removed_at])
}

model camp_bus_event {
  event_id              Int                 @id @default(autoincrement())
  bus_bus_id            Int
  student_assignment_id Int?
  teacher_assignment_id Int?
  teacher_teachers_id   Int?
  event_type            camp_bus_event_type
  latitude              Float?
  longitude             Float?
  accuracy_meters       Float?
  created_at            DateTime            @default(now())

  bus                camp_bus          @relation(fields: [bus_bus_id], references: [bus_id], onDelete: Cascade)
  student_assignment camp_bus_student? @relation(fields: [student_assignment_id], references: [assignment_id], onDelete: SetNull)
  teacher_assignment camp_bus_teacher? @relation(fields: [teacher_assignment_id], references: [assignment_id], onDelete: SetNull)
  teacher            teachers?         @relation(fields: [teacher_teachers_id], references: [teachers_id], onDelete: SetNull)

  @@index([bus_bus_id, created_at])
  @@index([student_assignment_id, created_at])
  @@index([teacher_assignment_id, created_at])
  @@index([event_type, created_at])
}

model teacher_enrollment {
  teacher_enrollment_id Int @id @default(autoincrement())

  teacher_teachers_id Int
  teacher             teachers              @relation(fields: [teacher_teachers_id], references: [teachers_id])
  camp_camp_id        Int
  camp                camp                  @relation(fields: [camp_camp_id], references: [camp_id])
  attendance_teachers attendance_teachers[]
}

model student_enrollment {
  student_enrollment_id           Int       @id @default(autoincrement())
  enrolled_at                     DateTime? // null = ยังไม่ได้กดเข้าร่วม
  shirt_size                      String?   @db.VarChar(10) // null = ยังไม่ได้ระบุ
  location_sharing_enabled        Boolean   @default(false)
  location_consent_at             DateTime?
  location_consent_by             String?   @db.VarChar(20)
  location_consent_notice_version String?   @db.VarChar(20)
  // jorn DateTime @default(now()) // นักเรียนลงทะเบียน

  student_students_id     Int
  student                 students           @relation(fields: [student_students_id], references: [students_id])
  camp_camp_id            Int
  camp                    camp               @relation(fields: [camp_camp_id], references: [camp_id])
  classroom_classroom_id  Int?
  classroom               classrooms?        @relation("EnrollmentClassroom", fields: [classroom_classroom_id], references: [classroom_id])
  academic_year_snapshot  Int?
  grade_snapshot          GradeLevel?
  classroom_name_snapshot String?            @db.VarChar(255)
  student_name_snapshot   String?            @db.VarChar(500)
  certificate             certificate[]
  mission_result          mission_result[]
  survey_response         survey_response[]
  camp_bus_student        camp_bus_student[]

  @@unique([student_students_id, camp_camp_id])
  @@index([camp_camp_id])
  @@index([classroom_classroom_id])
}

model attendance_session {
  id           Int                        @id @default(autoincrement())
  camp_camp_id Int
  camp         camp                       @relation(fields: [camp_camp_id], references: [camp_id])
  round_id     String                     @db.VarChar(64) // string id เช่น "l9x3r2ab"
  round_number Int
  description  String                     @db.VarChar(255)
  method       attendance_teachers_method @default(QR)
  nonce        String                     @db.VarChar(64)
  pin          String                     @db.VarChar(10)
  generated_at DateTime                   @default(now())
  expires_at   DateTime
  is_closed    Boolean                    @default(false)
  closed_at    DateTime?

  @@index([camp_camp_id])
  @@index([round_id])
}

model attendance_record_student {
  record_id                     Int      @id @default(autoincrement())
  checkin_time                  DateTime
  attendance_teacher_session_id Int
  student_students_id           Int
  image_url                     String?  @db.Text

  attendance_teachers_session_id attendance_teachers @relation(fields: [attendance_teacher_session_id], references: [session_id])
  student                        students            @relation(fields: [student_students_id], references: [students_id])

  @@unique([attendance_teacher_session_id, student_students_id], map: "attendance_record_session_student_key")
}

model attendance_teachers {
  session_id                               Int                        @id @default(autoincrement())
  description                              String                     @db.Text
  method                                   attendance_teachers_method
  created_at                               DateTime                   @default(now())
  expires_at                               DateTime?
  round_id                                 String?                    @db.VarChar(64)
  round_number                             Int                        @default(1)
  is_closed                                Boolean                    @default(false)
  closed_at                                DateTime?
  camp_camp_id                             Int
  camp                                     camp                       @relation(fields: [camp_camp_id], references: [camp_id])
  teacher_enrollment_teacher_enrollment_id Int
  teacher_enrollment                       teacher_enrollment         @relation(fields: [teacher_enrollment_teacher_enrollment_id], references: [teacher_enrollment_id])

  attendance_record_student attendance_record_student[]
}

enum attendance_teachers_method {
  QR
  NFC
  Image
  default
}

model certificate {
  certificate_id        Int                @id @default(autoincrement())
  issue_date            DateTime           @default(now())
  file_url              String             @db.VarChar(500)
  certificate_no        Int?
  certificate_no_star   Int?
  revoked_at            DateTime?
  revocation_reason     String?            @db.VarChar(500)
  student_enrollment_id Int                @unique
  student_enrollment    student_enrollment @relation(fields: [student_enrollment_id], references: [student_enrollment_id])
}

model station {
  station_id           Int     @id @default(autoincrement())
  name                 String  @db.VarChar(255)
  description          String  @db.VarChar(255)
  is_required_for_cert Boolean @default(true)

  camp_camp_id Int
  camp         camp @relation(fields: [camp_camp_id], references: [camp_id])

  mission   mission[]
  deletedAt DateTime?

  @@index([deletedAt])
}

enum MissionType {
  QUESTION_ANSWERING
  PHOTO_SUBMISSION
  VIDEO_SUBMISSION
  QR_CODE_SCANNING
  MULTIPLE_CHOICE_QUIZ
  PRE_TEST
  POST_TEST
}

model mission {
  mission_id  Int         @id @default(autoincrement())
  title       String?     @db.VarChar(255)
  description String?     @db.Text
  type        MissionType @default(QUESTION_ANSWERING)
  // instructions String? @db.Text

  station_station_id Int
  station            station @relation(fields: [station_station_id], references: [station_id])

  mission_result   mission_result[]
  mission_question mission_question[]
  deletedAt        DateTime?

  qr_pin   String? @db.VarChar(10)
  qr_nonce String? @db.VarChar(64)

  @@index([deletedAt])
}

model mission_result {
  mission_result_id Int                   @id @default(autoincrement())
  method            mission_result_method
  status            mission_result_status
  submitted_at      DateTime              @default(now())

  student_enrollment_id Int
  student_enrollment    student_enrollment @relation(fields: [student_enrollment_id], references: [student_enrollment_id])
  mission_mission_id    Int
  mission               mission            @relation(fields: [mission_mission_id], references: [mission_id])

  mission_answer mission_answer[]

  @@index([student_enrollment_id, mission_mission_id])
}

enum mission_result_method {
  NFC
  QR
  Code
  Aws
  Photo
}

enum mission_result_status {
  pending
  completed
}

model mission_question {
  question_id   Int                   @id @default(autoincrement())
  question_text String                @db.VarChar(255)
  question_type mission_question_type

  mission_mission_id Int
  mission            mission                   @relation(fields: [mission_mission_id], references: [mission_id])
  mission_answer     mission_answer[]
  choices            mission_question_choice[]
}

enum mission_question_type {
  MCQ
  TEXT
  PHOTO
}

model mission_question_choice {
  choice_id   Int     @id @default(autoincrement())
  choice_text String  @db.VarChar(255)
  is_correct  Boolean @default(false)

  mission_question_question_id Int
  mission_question             mission_question @relation(fields: [mission_question_question_id], references: [question_id], onDelete: Cascade)
}

model mission_answer {
  answer_id                        Int @id @default(autoincrement())
  mission_result_mission_result_id Int

  mission_result               mission_result   @relation(fields: [mission_result_mission_result_id], references: [mission_result_id])
  mission_question_question_id Int
  mission_question             mission_question @relation(fields: [mission_question_question_id], references: [question_id])

  answer_mcq   mission_answer_mcq[]
  answer_text  mission_answer_text[]
  answer_photo mission_answer_photo[]
}

model mission_answer_photo {
  id Int @id @default(autoincrement())

  mission_answer_id Int
  mission_answer    mission_answer @relation(fields: [mission_answer_id], references: [answer_id])

  img_url String @db.Text
}

model mission_answer_mcq {
  id                Int            @id @default(autoincrement())
  mission_answer_id Int
  mission_answer    mission_answer @relation(fields: [mission_answer_id], references: [answer_id])
  question_text     String         @db.VarChar(1)
}

model mission_answer_text {
  id                Int            @id @default(autoincrement())
  mission_answer_id Int
  mission_answer    mission_answer @relation(fields: [mission_answer_id], references: [answer_id])
  answer_text       String         @db.Text
}

model suggestion_analysis_summary {
  suggestion_analysis_summary_id Int             @id @default(autoincrement())
  summary_text                   String          @db.Text
  overall_sentiment              String          @db.VarChar(255)
  positive_themes                String          @db.Text
  improvement_areas              String          @db.Text
  positive_percentage            Float
  negative_percentage            Float
  survey_response_id             Int
  survey_response                survey_response @relation(fields: [survey_response_id], references: [response_id])
  survey_answer_id               Int
  survey_answer                  survey_answer   @relation(fields: [survey_answer_id], references: [answer_id])
}

model vulgar_words {
  vulgar_word_id Int      @id @default(autoincrement())
  word           String   @db.VarChar(255)
  is_ai          Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model survey {
  survey_id              Int       @id @default(autoincrement())
  title                  String    @db.VarChar(255)
  description            String?   @db.Text
  created_at             DateTime  @default(now())
  is_required_for_cert   Boolean   @default(true)
  is_accepting_responses Boolean   @default(true)
  ai_summary             Json?
  ai_summary_updated_at  DateTime?

  camp_camp_id Int  @unique
  camp         camp @relation(fields: [camp_camp_id], references: [camp_id])

  survey_question survey_question[]
  survey_response survey_response[]
}

model survey_question {
  question_id   Int                  @id @default(autoincrement())
  question_text String               @db.VarChar(255)
  question_type survey_question_type
  scale_max     Int?
  options       String?              @db.Text

  survey_survey_id Int
  survey           survey @relation(fields: [survey_survey_id], references: [survey_id], onDelete: Cascade)

  survey_answer survey_answer[]
}

// ติดตามว่านักเรียนคนไหนทำแบบสอบถามเสร็จแล้ว (สำหรับปลดล็อคประกาศนียบัตร)
model survey_response {
  response_id  Int      @id @default(autoincrement())
  submitted_at DateTime @default(now())

  survey_survey_id Int
  survey           survey @relation(fields: [survey_survey_id], references: [survey_id])

  student_enrollment_id       Int
  student_enrollment          student_enrollment            @relation(fields: [student_enrollment_id], references: [student_enrollment_id])
  suggestion_analysis_summary suggestion_analysis_summary[]
  survey_answer               survey_answer[]

  @@unique([survey_survey_id, student_enrollment_id])
}

model survey_answer {
  answer_id   Int     @id @default(autoincrement())
  text_answer String? @db.Text
  scale_value Int?

  survey_response_id Int
  survey_response    survey_response @relation(fields: [survey_response_id], references: [response_id], onDelete: Cascade)

  question_id                 Int
  survey_question             survey_question               @relation(fields: [question_id], references: [question_id])
  suggestion_analysis_summary suggestion_analysis_summary[]
}

// เทมเพลตแบบสอบถาม เพื่อนำกลับมาใช้ในครั้งต่อไป
model survey_template {
  template_id Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  created_at  DateTime @default(now())

  created_by_teacher_id Int
  created_by            teachers @relation(fields: [created_by_teacher_id], references: [teachers_id])

  survey_template_question survey_template_question[]
}

model survey_template_question {
  question_id   Int                  @id @default(autoincrement())
  question_text String               @db.VarChar(255)
  question_type survey_question_type
  scale_max     Int?
  options       String?              @db.Text

  template_id Int
  template    survey_template @relation(fields: [template_id], references: [template_id], onDelete: Cascade)
}

enum survey_question_type {
  text
  scale
  header
  grid
  checkbox
}

// One row per camp/recipient/reminder. This is the durable idempotency record
// for the email provider and lets the Cron job resume after a quota/error.
model camp_email_reminder {
  reminder_id         Int       @id @default(autoincrement())
  camp_camp_id        Int
  recipient_key       String    @db.VarChar(64) // student:123 or teacher:45
  recipient_email     String    @db.VarChar(255)
  recipient_name      String    @db.VarChar(255)
  camp_start_date_key String    @db.VarChar(10) // Bangkok date, YYYY-MM-DD
  reminder_type       String    @db.VarChar(30)
  status              String    @default("PENDING") @db.VarChar(20)
  attempts            Int       @default(0)
  provider_message_id String?   @db.VarChar(255)
  batch_key           String?   @db.VarChar(64)
  claim_token         String?   @db.VarChar(64)
  claimed_at          DateTime?
  sent_at             DateTime?
  last_error          String?   @db.Text
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  camp camp @relation(fields: [camp_camp_id], references: [camp_id], onDelete: Cascade)

  @@unique([camp_camp_id, recipient_key, camp_start_date_key, reminder_type])
  @@index([status, camp_start_date_key, created_at])
  @@index([camp_camp_id, status])
}

// One row per Bangkok calendar day. It serializes Cron executions and keeps
// the account-wide send budget durable across duplicate/manual invocations.
model camp_email_daily_run {
  date_key         String    @id @db.VarChar(10)
  attempted_count  Int       @default(0)
  sent_count       Int       @default(0)
  failed_count     Int       @default(0)
  uncertain_count  Int       @default(0)
  lock_token       String?   @db.VarChar(64)
  locked_at        DateTime?
  last_started_at  DateTime?
  last_finished_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([locked_at])
}
